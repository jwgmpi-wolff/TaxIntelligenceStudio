<ui:FluentWindow x:Class="TaxIntelligenceStudio.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Tax Intelligence Studio"
                 Icon="Assets/TaxIntelligenceStudio.ico"
                 Width="1240"
                 Height="820"
                 MinWidth="480"
                 MinHeight="480"
                 Background="{DynamicResource ComfortBackgroundBrush}"
                 Foreground="{DynamicResource ComfortTextBrush}"
                 FontFamily="Segoe UI"
                 FontSize="14"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource ComfortBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Tax Intelligence Studio"
                     Background="{DynamicResource ComfortBackgroundBrush}"
                     Foreground="{DynamicResource ComfortTextBrush}"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True" />

        <TabControl x:Name="AppTabs" Grid.Row="1" Margin="24,12,24,16">
            <TabControl.LayoutTransform>
                <ScaleTransform x:Name="AppScale" ScaleX="1" ScaleY="1" />
            </TabControl.LayoutTransform>
            <TabItem Header="1  IRS Knowledge">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="KnowledgeLayout" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="KnowledgeRowGap" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="KnowledgePrimaryColumn" Width="2*" />
                        <ColumnDefinition x:Name="KnowledgeColumnGap" Width="24" />
                        <ColumnDefinition x:Name="KnowledgeSecondaryColumn" Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="KnowledgeControls">
                        <TextBlock Text="IRS corpus ingestion" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,20"
                                   TextWrapping="Wrap"
                                   Opacity="0.75"
                                   Text="Reads IRS robots.txt and sitemaps, rate limits every request, stores full text and content hashes, and creates a new version only when source content changes." />
                        <TextBlock Text="Maximum documents (0 = all discoverable URLs)" />
                        <TextBox Margin="0,6,0,20"
                                 Width="180"
                                 HorizontalAlignment="Left"
                                 Text="{Binding MaximumDocuments, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Dataset file count (0 = automatic size-based splitting)" TextWrapping="Wrap" />
                        <TextBox Margin="0,6,0,8"
                                 Width="180"
                                 HorizontalAlignment="Left"
                                 IsEnabled="{Binding IsNotBusy}"
                                 Text="{Binding DatasetFileCount, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,20" TextWrapping="Wrap" Opacity="0.75"
                                   Text="A positive count divides all exported records evenly into that many JSONL files. The full dataset is also retained for local training." />
                        <WrapPanel>
                            <ui:Button Margin="0,0,12,0"
                                       Appearance="Primary"
                                       Command="{Binding CrawlCommand}"
                                       Content="Crawl and ingest IRS" />
                            <ui:Button Command="{Binding ExportDatasetCommand}"
                                       Content="Export training JSONL" />
                        </WrapPanel>
                    </StackPanel>

                    <Border x:Name="KnowledgeStatusCard"
                            Grid.Column="2"
                            Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="Knowledge status" FontSize="20" FontWeight="SemiBold" />
                            <ui:ProgressRing Margin="0,18,0,12"
                                             HorizontalAlignment="Left"
                                             IsIndeterminate="True"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding KnowledgeStatus}"
                                       TextWrapping="Wrap"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2  Financial Import">
                <ScrollViewer x:Name="FinancialScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="FinancialLayout" Margin="20" MinHeight="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Financial document ingestion" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,16"
                                   Text="Import PDF statements, CSV exports, Excel workbooks, or transaction text files." />
                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button Margin="0,0,12,0"
                                       Appearance="Primary"
                                       Command="{Binding ImportFilesCommand}"
                                       Content="Choose financial files" />
                            <ui:Button Command="{Binding AnalyzeCommand}"
                                       Content="Analyze for federal tax reporting" />
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,12"
                                   Text="{Binding FinancialStatus}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding FinancialProgress}" />
                        <TextBlock Margin="0,5,0,12"
                                   Text="{Binding FinancialProgressText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              Margin="0,0,0,12"
                              ItemsSource="{Binding FinancialFileImports}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding FileType}" Width="90" />
                            <DataGridTextColumn Header="Transactions" Binding="{Binding TransactionCount}" Width="110" />
                            <DataGridCheckBoxColumn Header="Parsed" Binding="{Binding Succeeded}" Width="75" />
                            <DataGridTextColumn Header="Diagnostic" Binding="{Binding Message}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Transactions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" />
                            <DataGridTextColumn Header="Tax form" Binding="{Binding TaxForm}" Width="105" />
                            <DataGridTextColumn Header="Box" Binding="{Binding TaxBox}" Width="65" />
                            <DataGridTextColumn Header="Year" Binding="{Binding TaxYear}" Width="65" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="140" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding RecognitionConfidence, StringFormat=P0}" Width="90" />
                            <DataGridTextColumn Header="Source" Binding="{Binding SourceFile}" Width="200" />
                            <DataGridTextColumn Header="Page/row" Binding="{Binding SourceRow}" Width="85" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3  1040 Analysis">
                <ScrollViewer x:Name="AnalysisScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="AnalysisLayout" Margin="20" MinHeight="520">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Form and schedule workpaper" FontSize="28" FontWeight="SemiBold" />
                        <ProgressBar Margin="0,12,0,0"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding AnalysisProgress}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding AnalysisProgressText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              Margin="0,16,0,18"
                              ItemsSource="{Binding Mappings}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="190" />
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="125" />
                            <DataGridTextColumn Header="Form / Schedule" Binding="{Binding Form}" Width="180" />
                            <DataGridTextColumn Header="Reporting destination" Binding="{Binding ReportingDestination}" Width="220" />
                            <DataGridTextColumn Header="Evidence and review requirement" Binding="{Binding Rationale}" Width="*" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2"
                               Text="Optimization review items"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <DataGrid Grid.Row="3"
                              Margin="0,10,0,0"
                              ItemsSource="{Binding Opportunities}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Opportunity" Binding="{Binding Title}" Width="230" />
                            <DataGridTextColumn Header="Candidate amount" Binding="{Binding PotentialAmount, StringFormat=C}" Width="140" />
                            <DataGridTextColumn Header="Explanation" Binding="{Binding Explanation}" Width="*" />
                            <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat=P0}" Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="4  Model Trainer">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="TrainerLayout" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TrainerPrimaryColumn" Width="*" />
                        <ColumnDefinition x:Name="TrainerColumnGap" Width="24" />
                        <ColumnDefinition x:Name="TrainerSecondaryColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="TrainerHeader">
                        <TextBlock Text="Hardware-accelerated LoRA trainer"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Text="CUDA GPUs use QLoRA. AMD, Intel, Qualcomm, and non-CUDA NVIDIA GPUs use real DirectML LoRA training. Windows NPUs are reserved for inference/evaluation because current NPU providers do not support weight training." />
                        <WrapPanel>
                            <ui:Button Margin="0,0,12,0"
                                       Appearance="Primary"
                                       Command="{Binding DetectHardwareCommand}"
                                       Content="Detect NPU and GPU" />
                            <ui:Button Command="{Binding RunAcceleratorSelfTestCommand}"
                                       Content="Run real accelerator self-test" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid x:Name="AcceleratorsGrid"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,16,0,16"
                              ItemsSource="{Binding Accelerators}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="130" />
                            <DataGridCheckBoxColumn Header="Training" Binding="{Binding SupportsTraining}" Width="100" />
                            <DataGridCheckBoxColumn Header="Inference" Binding="{Binding SupportsInference}" Width="100" />
                            <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="220" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="TrainerSettings" Grid.Row="2" IsEnabled="{Binding CanEditTraining}">
                        <TextBlock Text="Base type / model family" />
                        <ComboBox Margin="0,5,0,12"
                                  ItemsSource="{Binding ModelFamilies}"
                                  SelectedItem="{Binding SelectedModelFamily}" />
                        <TextBlock Text="Base model" />
                        <ComboBox Margin="0,5,0,12"
                                  ItemsSource="{Binding AvailableBaseModels}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ModelId"
                                  SelectedValue="{Binding BaseModel}" />
                        <TextBlock Text="Selected or custom local/Hugging Face model ID" />
                        <TextBox Margin="0,5,0,12"
                                 Text="{Binding BaseModel, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Grounded JSONL datasets (one combined training run)" />
                        <WrapPanel Margin="0,5,0,6">
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding ChooseTrainingDatasetCommand}"
                                       Content="Add datasets..." />
                            <ui:Button Margin="0,0,8,0"
                                       Command="{Binding RemoveTrainingDatasetCommand}"
                                       Content="Remove selected" />
                            <ui:Button Command="{Binding ClearTrainingDatasetsCommand}"
                                       Content="Clear queue" />
                        </WrapPanel>
                        <ListBox Margin="0,0,0,6"
                                 Height="120"
                                 ItemsSource="{Binding TrainingDatasetPaths}"
                                 SelectedItem="{Binding SelectedTrainingDataset}"
                                 IsEnabled="{Binding CanEditTraining}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        <TextBlock Margin="0,0,0,12"
                                   Text="{Binding TrainingDatasetSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Python executable" />
                        <TextBox Margin="0,5,0,0"
                                 Text="{Binding PythonExecutable, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel x:Name="TrainerRunPanel" Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Adapter output directory" />
                        <DockPanel Margin="0,5,0,12" IsEnabled="{Binding CanEditTraining}">
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding ChooseTrainingOutputCommand}"
                                       Content="Browse" />
                            <TextBox Text="{Binding TrainingOutputDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                        <TextBlock Text="Resume checkpoint" />
                        <DockPanel Margin="0,5,0,12" IsEnabled="{Binding CanEditTraining}">
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding RefreshCheckpointsCommand}"
                                       Content="Refresh" />
                            <ComboBox ItemsSource="{Binding TrainingCheckpoints}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedCheckpoint}" />
                        </DockPanel>
                        <CheckBox Margin="0,0,0,12"
                                  IsEnabled="{Binding CanEditTraining}"
                                  IsChecked="{Binding AllowCpuFallback}"
                                  Content="Allow CPU fallback (slow; never selected silently)" />
                        <ui:Button HorizontalAlignment="Left"
                                   Appearance="Primary"
                                   Command="{Binding TrainModelCommand}"
                                   Content="Start LoRA fine-tuning" />
                        <ui:Button HorizontalAlignment="Left" Margin="0,8,0,0"
                                   Command="{Binding TrainModelCancelCommand}"
                                   Content="Cancel training" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Training and inference can run together. They share CPU/GPU and memory; concurrent jobs can be slower or run out of memory. Inference keeps using the activated adapter, not the adapter being trained." />
                        <ProgressBar Margin="0,14,0,0"
                                     Height="12"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding TrainingProgress}" />
                        <TextBlock Margin="0,6,0,0"
                                   Text="{Binding TrainingProgressText}"
                                   TextWrapping="Wrap" />
                        <TextBox Margin="0,14,0,0"
                                 Height="130"
                                 Text="{Binding TrainingStatus}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" />
                        <Expander Header="Recent fine-tuning datasets" Margin="0,12,0,12">
                            <StackPanel>
                                <ui:Button HorizontalAlignment="Left" Content="Refresh dataset log"
                                           Command="{Binding RefreshTrainingDatasetHistoryCommand}" />
                                <ListBox Margin="0,6,0,6" Height="110"
                                         ItemsSource="{Binding RecentTrainingDatasets}"
                                         SelectedItem="{Binding SelectedTrainingDatasetLog}"
                                         DisplayMemberPath="Summary" />
                                <TextBox Height="150" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedTrainingDatasetLog.Details, Mode=OneWay}" />
                                <TextBlock Text="{Binding TrainingDatasetHistoryStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="5  Agent Model">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="AgentLayout" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="AgentPrimaryColumn" Width="*" />
                        <ColumnDefinition x:Name="AgentColumnGap" Width="24" />
                        <ColumnDefinition x:Name="AgentSecondaryColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="AgentHeader" Grid.ColumnSpan="3">
                        <TextBlock Text="Agent model deployment"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Text="Discover completed LoRA adapters or checkpoint adapters, activate one for local PEFT inference, or merge it into a standalone model and register it with Ollama." />
                        <DockPanel>
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding DiscoverAgentModelsCommand}"
                                       Content="Discover models" />
                            <ui:Button DockPanel.Dock="Right"
                                       Margin="8,0,0,0"
                                       Command="{Binding ChooseAgentModelRootCommand}"
                                       Content="Browse" />
                            <TextBox Text="{Binding AgentModelRoot, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </StackPanel>

                    <DataGrid x:Name="AgentModelsGrid"
                              Grid.Row="1"
                              Grid.ColumnSpan="3"
                              Margin="0,16,0,16"
                              ItemsSource="{Binding AgentModels}"
                              SelectedItem="{Binding SelectedAgentModel}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Base model" Binding="{Binding BaseModel}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding ArtifactType}" Width="160" />
                            <DataGridCheckBoxColumn Header="Ready" Binding="{Binding CanActivate}" Width="70" />
                            <DataGridTextColumn Header="Step" Binding="{Binding TrainingStep}" Width="90" />
                            <DataGridTextColumn Header="Saved" Binding="{Binding SavedAt, StringFormat=g}" Width="150" />
                            <DataGridTextColumn Header="Adapter path" Binding="{Binding AdapterPath}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="AgentDeploymentPanel" Grid.Row="2">
                        <TextBlock Text="Deployment runtime" />
                        <ComboBox Margin="0,5,0,12"
                                  ItemsSource="{Binding AgentRuntimes}"
                                  SelectedItem="{Binding SelectedAgentRuntime}" />
                        <TextBlock Text="Ollama model name" />
                        <TextBox Margin="0,5,0,12"
                                 Text="{Binding OllamaModelName, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button HorizontalAlignment="Left"
                                   Appearance="Primary"
                                   Command="{Binding ActivateAgentModelCommand}"
                                   Content="Activate selected model" />
                        <TextBlock Margin="0,18,0,4"
                                   FontWeight="SemiBold"
                                   Text="Active model" />
                        <TextBlock Text="{Binding ActiveAgentModelSummary}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,18,0,4"
                                   FontWeight="SemiBold"
                                   Text="Deployment status" />
                        <TextBox Height="110"
                                 Text="{Binding AgentStatus}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="AgentTestPanel" Grid.Row="2" Grid.Column="2">
                        <TextBlock Text="Local agent test prompt" />
                        <TextBox Margin="0,5,0,12"
                                 Height="80"
                                 Text="{Binding AgentPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                        <ui:Button HorizontalAlignment="Left"
                                   Command="{Binding TestAgentModelCommand}"
                                   Content="Run test prompt" />
                        <TextBlock Margin="0,18,0,4"
                                   FontWeight="SemiBold"
                                   Text="Model response" />
                        <TextBox Height="180"
                                 Text="{Binding AgentResponse}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="6  Reports">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ReportsLayout" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition x:Name="ReportsRowGap" Height="0" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ReportsPrimaryColumn" Width="2*" />
                        <ColumnDefinition x:Name="ReportsColumnGap" Width="24" />
                        <ColumnDefinition x:Name="ReportsSecondaryColumn" Width="3*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ReportsControls">
                        <TextBlock Text="Tax workpaper export" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,20"
                                   TextWrapping="Wrap"
                                   Text="Before export, every cited IRS form page is fetched live. If any source cannot be verified, report generation is blocked." />
                        <WrapPanel>
                            <ui:Button Margin="0,0,12,0"
                                       Appearance="Primary"
                                       Command="{Binding ExportPdfCommand}"
                                       Content="Export PDF" />
                            <ui:Button Command="{Binding ExportWordCommand}"
                                       Content="Export Word" />
                        </WrapPanel>
                    </StackPanel>
                    <Border x:Name="ReportsStatusCard"
                            Grid.Column="2"
                            Padding="24"
                            CornerRadius="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="Report status" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Margin="0,16,0,0"
                                       Text="{Binding ReportStatus}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="7  Model Inference">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20">
                        <TextBlock Text="Model provider inference"
                                   FontSize="28"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,8,0,16"
                                   TextWrapping="Wrap"
                                   Text="Trained uses the adapter activated in Agent Model through local Python/PEFT, with IRS cache retrieval and conversation history. Local uses the configured Ollama/OpenAI-compatible endpoint. Azure sends the conversation to the configured cloud deployment. No provider fallback occurs. Cached sources may be outdated; responses are not verified tax advice." />
                        <TextBlock Text="Provider" />
                        <ComboBox Margin="0,5,0,12"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  ItemsSource="{Binding ModelProviderIds}"
                                  IsEnabled="{Binding IsNotBusy}"
                                  SelectedItem="{Binding SelectedInferenceProvider}" />
                        <TextBlock Text="Active trained adapter (used by Trained, not Local)"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,12"
                                   Text="{Binding ActiveAgentModelSummary}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,0,0,12">
                            <ui:Button Margin="0,0,12,0"
                                       Command="{Binding RefreshModelProvidersCommand}"
                                       Content="Check provider availability" />
                            <ui:Button Appearance="Primary"
                                       Command="{Binding RunModelInferenceCommand}"
                                       Content="Send message" />
                            <ui:Button Margin="12,0,0,0"
                                       Command="{Binding NewModelConversationCommand}"
                                       Content="New conversation" />
                            <ui:Button Margin="12,0,0,0"
                                       Command="{Binding RunModelInferenceCancelCommand}"
                                       Content="Cancel request" />
                        </WrapPanel>
                        <TextBlock Margin="0,0,0,12"
                                   Text="{Binding ModelProviderStatus}"
                                   TextWrapping="Wrap" />
                        <ProgressBar Height="8"
                                     Margin="0,0,0,6"
                                     IsIndeterminate="True">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInferenceRunning}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Margin="0,0,0,12"
                                   Text="{Binding ModelInferenceElapsed}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Images and documents for your next message" FontWeight="SemiBold" />
                        <TextBlock Margin="0,5,0,6" TextWrapping="Wrap"
                                   Text="Extracted text/findings are included in the conversation, not training data. Local processing only; choosing Azure for the chat sends extracted content to Azure. Review OCR for errors. Image options apply when adding files; PDF/Office attachments are text/OCR only." />
                        <WrapPanel IsEnabled="{Binding IsNotBusy}" Margin="0,0,0,6">
                            <CheckBox Margin="0,0,16,0" Content="Detect/count faces (no identity)"
                                      IsChecked="{Binding DetectAttachmentFaces}" />
                            <CheckBox Content="Describe objects/scenes using local vision model (may be slow)"
                                      IsChecked="{Binding DescribeAttachmentObjects}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6">
                            <ui:Button Content="Add images/documents..." Command="{Binding AddInferenceAttachmentsCommand}" />
                            <ui:Button Margin="8,0,0,0" Content="Remove attachment" Command="{Binding RemoveInferenceAttachmentCommand}" />
                            <ui:Button Margin="8,0,0,0" Content="Clear attachments" Command="{Binding ClearInferenceAttachmentsCommand}" />
                            <ui:Button Margin="8,0,0,0" Content="Cancel extraction" Command="{Binding AddInferenceAttachmentsCancelCommand}" />
                        </WrapPanel>
                        <ListBox Height="80" ItemsSource="{Binding InferenceAttachmentItems}"
                                 SelectedItem="{Binding SelectedInferenceAttachment}"
                                 DisplayMemberPath="Summary" IsEnabled="{Binding IsNotBusy}" />
                        <TextBlock Margin="0,5,0,6" TextWrapping="Wrap" Text="{Binding InferenceAttachmentStatus}" />
                        <Expander Header="Review selected attachment extraction" Margin="0,0,0,12">
                            <TextBox Height="160" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding SelectedInferenceAttachment.Content, Mode=OneWay}" />
                        </Expander>
                        <TextBlock Text="Your message (question or follow-up)" />
                        <Expander Header="Saved prompts (local history)" Margin="0,6,0,8">
                            <StackPanel>
                                <TextBlock Text="Sent typed prompts are saved on this device, even if generation fails. Replies and attachment excerpts are excluded."
                                           TextWrapping="Wrap" />
                                <ListBox Height="110" ItemsSource="{Binding SavedPrompts}"
                                         SelectedItem="{Binding SelectedSavedPrompt}" DisplayMemberPath="DisplayText"
                                         IsEnabled="{Binding IsNotBusy}" />
                                <TextBox Height="75" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Text="{Binding SelectedSavedPrompt.Prompt, Mode=OneWay}" />
                                <WrapPanel Margin="0,6,0,6">
                                    <ui:Button Content="Reuse selected prompt" Command="{Binding ReusePromptCommand}" />
                                    <ui:Button Content="Delete selected" Margin="8,0,0,0" Command="{Binding DeletePromptCommand}" />
                                    <ui:Button Content="Clear history" Margin="8,0,0,0" Command="{Binding ClearPromptHistoryCommand}" />
                                    <ui:Button Content="Refresh history" Margin="8,0,0,0" Command="{Binding LoadPromptHistoryCommand}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding PromptHistoryStatus}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        <TextBox Margin="0,5,0,16"
                                 MinHeight="100"
                                 AcceptsReturn="True"
                                 IsEnabled="{Binding IsNotBusy}"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ModelInferencePrompt, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Conversation" FontWeight="SemiBold" />
                        <TextBlock Margin="0,6,0,6" TextWrapping="Wrap"
                                   Text="AI-generated, not verified tax advice. Numbers and citations can still be wrong. Numeric screening catches only some errors; independently verify the entire answer before relying on it. Start a new conversation after an unreliable reply." />
                        <WrapPanel Margin="0,8,0,8">
                            <ui:Button Content="Export response PDF" Command="{Binding ExportInferencePdfCommand}" />
                            <ui:Button Margin="8,0,0,0" Content="Export response Word" Command="{Binding ExportInferenceWordCommand}" />
                            <CheckBox Margin="16,0,0,0" Content="Include full conversation"
                                      IsEnabled="{Binding IsNotBusy}"
                                      IsChecked="{Binding ExportFullInferenceConversation}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding InferenceExportStatus}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox Margin="0,5,0,0"
                                 MinHeight="220"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding ModelInferenceResponse}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</ui:FluentWindow>
