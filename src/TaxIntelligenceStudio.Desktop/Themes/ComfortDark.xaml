<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Color x:Key="ComfortBackgroundColor">#203F70</Color>
    <Color x:Key="ComfortSurfaceColor">#294C7C</Color>
    <Color x:Key="ComfortInputColor">#1D385F</Color>
    <Color x:Key="ComfortHoverColor">#365E91</Color>
    <Color x:Key="ComfortTextColor">#F1F5F9</Color>
    <Color x:Key="ComfortSecondaryTextColor">#C4D2E0</Color>
    <Color x:Key="ComfortDisabledTextColor">#B5C6DC</Color>
    <Color x:Key="ComfortBorderColor">#7796BE</Color>
    <Color x:Key="ComfortAccentColor">#A7E3B0</Color>
    <Color x:Key="ComfortSelectionColor">#294E48</Color>
    <SolidColorBrush x:Key="ComfortBackgroundBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="ComfortSurfaceBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ComfortInputBrush" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="ComfortHoverBrush" Color="{StaticResource ComfortHoverColor}" />
    <SolidColorBrush x:Key="ComfortTextBrush" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ComfortSecondaryTextBrush" Color="{StaticResource ComfortSecondaryTextColor}" />
    <SolidColorBrush x:Key="ComfortDisabledTextBrush" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="ComfortBorderBrush" Color="{StaticResource ComfortBorderColor}" />
    <SolidColorBrush x:Key="ComfortAccentBrush" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="ComfortSelectionBrush" Color="{StaticResource ComfortSelectionColor}" />
    <Color x:Key="ApplicationBackgroundColor">#203F70</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="WindowForeground" Color="{StaticResource ComfortTextColor}" />
    <Color x:Key="SolidBackgroundFillColorBase">#203F70</Color>
    <Color x:Key="SolidBackgroundFillColorBaseAlt">#203F70</Color>
    <Color x:Key="SolidBackgroundFillColorSecondary">#294C7C</Color>
    <Color x:Key="SolidBackgroundFillColorTertiary">#294C7C</Color>
    <Color x:Key="TextFillColorPrimary">#F1F5F9</Color>
    <Color x:Key="TextFillColorSecondary">#C4D2E0</Color>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseAltBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource ComfortHoverColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource ComfortSecondaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource ComfortSecondaryTextColor}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="{StaticResource ComfortHoverColor}" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource ComfortBorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource ComfortBorderColor}" />
    <SolidColorBrush x:Key="FocusStrokeColorOuterBrush" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="KeyboardFocusBorderColorBrush" Color="{StaticResource ComfortAccentColor}" />

    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{StaticResource ComfortHoverColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{StaticResource ComfortSelectionColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#BCECC3" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#8FCF9A" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource ComfortBackgroundColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource ComfortBackgroundColor}" />

    <SolidColorBrush x:Key="TextControlBackground" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="TextControlForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="{StaticResource ComfortSecondaryTextColor}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="{StaticResource ComfortHoverColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundFocused" Color="{StaticResource ComfortInputColor}" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="{StaticResource ComfortSelectionColor}" />
    <SolidColorBrush x:Key="ComboBoxItemForegroundSelected" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ListBoxItemForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedBackgroundThemeBrush" Color="{StaticResource ComfortSelectionColor}" />
    <SolidColorBrush x:Key="ListBoxItemSelectedForegroundThemeBrush" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="{StaticResource ComfortBorderColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="{StaticResource ComfortSurfaceColor}" />
    <SolidColorBrush x:Key="CheckBoxForeground" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="CheckBoxForegroundUncheckedDisabled" Color="{StaticResource ComfortDisabledTextColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{StaticResource ComfortAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#BCECC3" />
    <SolidColorBrush x:Key="CheckBoxCheckGlyphForeground" Color="{StaticResource ComfortBackgroundColor}" />

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource ComfortSelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource ComfortTextColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource ComfortSelectionColor}" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource ComfortTextColor}" />

    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ComfortInputBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource ComfortAccentBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource ComfortAccentBrush}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="{StaticResource ComfortBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ComfortBackgroundBrush}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="0,0,0,2"
                            CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="TabHeader" ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{StaticResource ComfortSecondaryTextBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
                            <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="{StaticResource ComfortAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ComfortHoverBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ComfortSurfaceBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{StaticResource ComfortInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="3,2" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
                <Setter Property="Background" Value="{StaticResource ComfortHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
                <Setter Property="Background" Value="{StaticResource ComfortSelectionBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource ComfortDisabledTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="Background" Value="{StaticResource ComfortInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="Background" Value="{StaticResource ComfortInputBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource ComfortInputBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource ComfortSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource ComfortHoverBrush}" />
        <Setter Property="RowHeight" Value="36" />
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
        <Setter Property="Background" Value="{StaticResource ComfortSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource ComfortSelectionBrush}" />
                <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource ComfortAccentBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background" Value="{StaticResource ComfortSurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ComfortTextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComfortBorderBrush}" />
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{StaticResource ComfortAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource ComfortHoverBrush}" />
    </Style>
</ResourceDictionary>
